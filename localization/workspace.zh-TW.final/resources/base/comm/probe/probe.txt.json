  "entries": [
    {
      "index": 0,
      "label": "WE_COME_IN_PEACE_1",
      "header_suffix": " probe-000.ogg",
      "audio": "probe-000.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "WE COME IN PEACE.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "WE COME IN PEACE.",
      "translation": "本探測器為和平而來。"
    },
    {
      "index": 1,
      "label": "WE_COME_IN_PEACE_2",
      "header_suffix": " probe-001.ogg",
      "audio": "probe-001.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "WE BRING GREETINGS FROM A FRIENDLY SPECIES.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "WE BRING GREETINGS FROM A FRIENDLY SPECIES.",
      "translation": "本探測器帶來友善物種的問 候。"
    },
    {
      "index": 2,
      "label": "WE_COME_IN_PEACE_3",
      "header_suffix": " probe-002.ogg",
      "audio": "probe-002.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "DO NOT FEAR. WE SHALL NOT HARM YOU.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "DO NOT FEAR. WE SHALL NOT HARM YOU.",
      "translation": "請勿恐懼。本探測器不會傷 害你。"
    },
    {
      "index": 3,
      "label": "WE_COME_IN_PEACE_4",
      "header_suffix": " probe-003.ogg",
      "audio": "probe-003.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS IS PROBE 2418-B, ON A PEACEFUL MISSION.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS IS PROBE 2418-B, ON A PEACEFUL MISSION.",
      "translation": "本機為 2418-B 號探測器，正在執行和平任 務。"
    },
    {
      "index": 4,
      "label": "WE_COME_IN_PEACE_5",
      "header_suffix": " probe-004.ogg",
      "audio": "probe-004.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "WE ARE NOT HOSTILE AND SEEK TO ESTABLISH FRIENDLY RELATIONS WITH YOUR SPECIES.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "WE ARE NOT HOSTILE AND SEEK TO ESTABLISH FRIENDLY RELATIONS WITH YOUR SPECIES.",
      "translation": "本探測器不具敵意， 並試圖與你方物種建立友好 關係。"
    },
    {
      "index": 5,
      "label": "WE_COME_IN_PEACE_6",
      "header_suffix": " probe-005.ogg",
      "audio": "probe-005.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "WE WISH TO LEARN MORE ABOUT YOU. PLEASE TRANSMIT DATA.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "WE WISH TO LEARN MORE ABOUT YOU. PLEASE TRANSMIT DATA.",
      "translation": "本探測器希望深入了解你 方。請傳送資料。"
    },
    {
      "index": 6,
      "label": "WE_COME_IN_PEACE_7",
      "header_suffix": " probe-006.ogg",
      "audio": "probe-006.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS PROBE IS NOT HOSTILE. DO NOT ATTACK.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS PROBE IS NOT HOSTILE. DO NOT ATTACK.",
      "translation": "本探測器不具敵意。 請勿攻擊。"
    },
    {
      "index": 7,
      "label": "WE_COME_IN_PEACE_8",
      "header_suffix": " probe-007.ogg",
      "audio": "probe-007.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "WE COME IN PEACE.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "WE COME IN PEACE.",
      "translation": "本探測器為和平而來。"
    },
    {
      "index": 8,
      "label": "threat_1",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Submit or be destroyed!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Submit or be destroyed!",
      "translation": "投降，否則就摧毀你！"
    },
    {
      "index": 9,
      "label": "threat_2",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Attention alien probe. You must cease hostilities or face our wrath.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Attention alien probe. You must cease hostilities or face our wrath.",
      "translation": "外星探測器注意。 你必須停止敵對行動， 否則承受我們的怒火。"
    },
    {
      "index": 10,
      "label": "threat_3",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Look here, probe! We have tried to be nice, but you keep shooting at us. So now, we fight!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Look here, probe! We have tried to be nice, but you keep shooting at us. So now, we fight!",
      "translation": "聽著，探測器！ 我們試著好好相處， 你卻一直朝我們開火。 所以現在開打！"
    },
    {
      "index": 11,
      "label": "threat_4",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Prepare to be annihilated!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Prepare to be annihilated!",
      "translation": "準備遭到殲滅！"
    },
    {
      "index": 12,
      "label": "PROGRAMMED_TO_DEFEND_1",
      "header_suffix": " probe-008.ogg",
      "audio": "probe-008.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS PROBE IS PROGRAMMED TO DEFEND AGAINST HOSTILE BEHAVIOR.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS PROBE IS PROGRAMMED TO DEFEND AGAINST HOSTILE BEHAVIOR.",
      "translation": "本探測器已設定程式， 以抵禦敵對行為。"
    },
    {
      "index": 13,
      "label": "PROGRAMMED_TO_DEFEND_2",
      "header_suffix": " probe-009.ogg",
      "audio": "probe-009.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "SURVIVAL SYSTEM SUBROUTINE HAS BEEN ACTIVATED. WEAPONS ENGAGED.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "SURVIVAL SYSTEM SUBROUTINE HAS BEEN ACTIVATED. WEAPONS ENGAGED.",
      "translation": "生存系統子程序已啟動。 武器已上線。"
    },
    {
      "index": 14,
      "label": "PROGRAMMED_TO_DEFEND_3",
      "header_suffix": " probe-010.ogg",
      "audio": "probe-010.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "ENACTING THIRD LAW.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "ENACTING THIRD LAW.",
      "translation": "正在執行第三法則。"
    },
    {
      "index": 15,
      "label": "PROGRAMMED_TO_DEFEND_4",
      "header_suffix": " probe-011.ogg",
      "audio": "probe-011.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "DEFENSE SYSTEM HAS BEEN ENGAGED. HOSTILITIES COMMENCE.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "DEFENSE SYSTEM HAS BEEN ENGAGED. HOSTILITIES COMMENCE.",
      "translation": "防禦系統已啟動。 敵對行動開始。"
    },
    {
      "index": 16,
      "label": "something_wrong_1",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "What can you tell me about your species?",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "What can you tell me about your species?",
      "translation": "你能介紹自己的物種嗎？"
    },
    {
      "index": 17,
      "label": "something_wrong_2",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Is there something wrong? We seem to be miscommunicating.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Is there something wrong? We seem to be miscommunicating.",
      "translation": "有什麼問題嗎？ 我們好像溝通不良。"
    },
    {
      "index": 18,
      "label": "something_wrong_3",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Look, try to understand. We mean you no harm!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Look, try to understand. We mean you no harm!",
      "translation": "聽著，試著理解。 我們無意傷害你！"
    },
    {
      "index": 19,
      "label": "something_wrong_4",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "I am having a lot of trouble dealing with this. What's your problem?",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "I am having a lot of trouble dealing with this. What's your problem?",
      "translation": "我真的很難應付這種狀況。 你到底有什麼毛病？"
    },
    {
      "index": 20,
      "label": "NOMINAL_FUNCTION_1",
      "header_suffix": " probe-012.ogg",
      "audio": "probe-012.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "REMOTE PROBE PROGRAMMED TO REPLICATE - RECORD DATA - CONTACT ALIEN SPECIES.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "REMOTE PROBE PROGRAMMED TO REPLICATE - RECORD DATA - CONTACT ALIEN SPECIES.",
      "translation": "遠端探測器程式設定： 自我複製－記錄資料－接觸 外星物種。"
    },
    {
      "index": 21,
      "label": "NOMINAL_FUNCTION_2",
      "header_suffix": " probe-013.ogg",
      "audio": "probe-013.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "ACCORDING TO INTERNAL MONITORS THERE ARE NO MALFUNCTIONS.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "ACCORDING TO INTERNAL MONITORS THERE ARE NO MALFUNCTIONS.",
      "translation": "根據內部監測器， 沒有任何故障。"
    },
    {
      "index": 22,
      "label": "NOMINAL_FUNCTION_3",
      "header_suffix": " probe-014.ogg",
      "audio": "probe-014.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "I WILL INITIATE SYSTEMS CHECK LEVEL FOUR.\nCHECKING... CHECKING... CHECKING...\nSYSTEMS CHECK LEVEL FOUR REPORTS NO ABNORMALITIES OR MALFUNCTIONS.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "I WILL INITIATE SYSTEMS CHECK LEVEL FOUR.\nCHECKING... CHECKING... CHECKING...\nSYSTEMS CHECK LEVEL FOUR REPORTS NO ABNORMALITIES OR MALFUNCTIONS.",
      "translation": "將啟動第四級系統檢查。\n檢查中……檢查中…… 檢查中……\n第四級系統檢查報告： 無異常或故障。"
    },
    {
      "index": 23,
      "label": "NOMINAL_FUNCTION_4",
      "header_suffix": " probe-015.ogg",
      "audio": "probe-015.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "ALL SYSTEMS REPORT NOMINAL FUNCTION.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "ALL SYSTEMS REPORT NOMINAL FUNCTION.",
      "translation": "所有系統回報功能正常。"
    },
    {
      "index": 24,
      "label": "we_are_us_1",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "We are from Earth, on a mission of peace.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "We are from Earth, on a mission of peace.",
      "translation": "我們來自地球， 正在執行和平任務。"
    },
    {
      "index": 25,
      "label": "we_are_us_2",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "We too come in peace, please believe us!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "We too come in peace, please believe us!",
      "translation": "我們也是為和平而來， 請相信我們！"
    },
    {
      "index": 26,
      "label": "we_are_us_3",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Hmmm.. maybe reverse psychology would work. Er... Die alien scum!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Hmmm.. maybe reverse psychology would work. Er... Die alien scum!",
      "translation": "嗯……也許逆向心理會有 效。呃……去死吧， 外星垃圾！"
    },
    {
      "index": 27,
      "label": "we_are_us_4",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "In case you don't already know, we are the nice people from Earth who you keep attacking.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "In case you don't already know, we are the nice people from Earth who you keep attacking.",
      "translation": "如果你還不知道， 我們就是那群一直被你攻 擊、來自地球的好人。"
    },
    {
      "index": 28,
      "label": "THIS_IS_PROBE_1",
      "header_suffix": " probe-016.ogg",
      "audio": "probe-016.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS IS PROBE 2418-B. WE ARE ON A PEACEFUL MISSION OF EXPLORATION.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS IS PROBE 2418-B. WE ARE ON A PEACEFUL MISSION OF EXPLORATION.",
      "translation": "本機為 2418-B 號探測器。正在執行和平探 索任務。"
    },
    {
      "index": 29,
      "label": "THIS_IS_PROBE_2",
      "header_suffix": " probe-017.ogg",
      "audio": "probe-017.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS IS PROBE 2418-B. WE SEEK TO MAKE FRIENDLY CONTACT WITH ALIEN LIFE FORMS.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS IS PROBE 2418-B. WE SEEK TO MAKE FRIENDLY CONTACT WITH ALIEN LIFE FORMS.",
      "translation": "本機為 2418-B 號探測器。正在尋求與外星 生命體建立友好接觸。"
    },
    {
      "index": 30,
      "label": "THIS_IS_PROBE_3",
      "header_suffix": " probe-018.ogg",
      "audio": "probe-018.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS IS PROBE 2418-B. WE REPLICATE SO THAT WE MAY EXPAND THE SCOPE OF MISSION.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS IS PROBE 2418-B. WE REPLICATE SO THAT WE MAY EXPAND THE SCOPE OF MISSION.",
      "translation": "本機為 2418-B 號探測器。執行自我複製， 以擴大任務範圍。"
    },
    {
      "index": 31,
      "label": "THIS_IS_PROBE_40",
      "header_suffix": " probe-019.ogg",
      "audio": "probe-019.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "THIS IS PROBE 2418-B. ",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "THIS IS PROBE 2418-B. ",
      "translation": "本機為 2418-B 號探測器。 "
    },
    {
      "index": 32,
      "label": "THIS_IS_PROBE_41",
      "header_suffix": " probe-030.ogg",
      "audio": "probe-030.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "COORDINATES ARE: ",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "COORDINATES ARE: ",
      "translation": "座標為： "
    },
    {
      "index": 33,
      "label": "THIS_IS_PROBE_42",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": ". ",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": ". ",
      "translation": "。 "
    },
    {
      "index": 34,
      "label": "why_attack_1",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "We reach out our appendage in friendship. What is your response?",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "We reach out our appendage in friendship. What is your response?",
      "translation": "我們伸出附肢表示友好。 你方如何回應？"
    },
    {
      "index": 35,
      "label": "why_attack_2",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "Why do you attack us? We are not hostile to your life form.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "Why do you attack us? We are not hostile to your life form.",
      "translation": "為何攻擊本探測器？ 本探測器對你方生命型態不 具敵意。"
    },
    {
      "index": 36,
      "label": "why_attack_3",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "You misinterpret our intentions. Please do not attack!",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "You misinterpret our intentions. Please do not attack!",
      "translation": "你方誤解本探測器意圖。 請勿攻擊！"
    },
    {
      "index": 37,
      "label": "why_attack_4",
      "header_suffix": "",
      "audio": null,
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "What's the use? I bet regardless what I say, you'll just attack.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "What's the use? I bet regardless what I say, you'll just attack.",
      "translation": "有什麼用？我敢說不管講什 麼，你都只會攻擊。"
    },
    {
      "index": 38,
      "label": "PEACEFUL_MISSION_1",
      "header_suffix": " probe-020.ogg",
      "audio": "probe-020.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "MISSION DESCRIPTION FOLLOWS:\nTRAVERSE SPACE RECORDING DATA\nSEEK MATERIALS FOR REPLICATION\nREPLICATE TO EXPAND SCOPE OF MISSION\nCONTACT LIFE FORMS IN PEACEFUL MANNER\nAFTER TEN REPLICATIONS, RETURN TO POINT OF ORIGIN\nEND OF MISSION DESCRIPTION.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "MISSION DESCRIPTION FOLLOWS:\nTRAVERSE SPACE RECORDING DATA\nSEEK MATERIALS FOR REPLICATION\nREPLICATE TO EXPAND SCOPE OF MISSION\nCONTACT LIFE FORMS IN PEACEFUL MANNER\nAFTER TEN REPLICATIONS, RETURN TO POINT OF ORIGIN\nEND OF MISSION DESCRIPTION.",
      "translation": "任務說明如下：\n穿越太空並記錄資料\n尋找自我複製所需材料\n進行自我複製以擴大任務範 圍\n以和平方式接觸生命體\n完成十次自我複製後返回起 始點\n任務說明結束。"
    },
    {
      "index": 39,
      "label": "PEACEFUL_MISSION_2",
      "header_suffix": " probe-021.ogg",
      "audio": "probe-021.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "BEHAVIOR FOLLOWS DICTATED PRIORITIES\nREPLICATION\nDATA GATHERING\nCONTACTING ALIEN LIFE FORMS IN PEACEFUL MANNER.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "BEHAVIOR FOLLOWS DICTATED PRIORITIES\nREPLICATION\nDATA GATHERING\nCONTACTING ALIEN LIFE FORMS IN PEACEFUL MANNER.",
      "translation": "行為遵循指定優先順序\n自我複製\n資料蒐集\n以和平方式接觸外星生命 體。"
    },
    {
      "index": 40,
      "label": "PEACEFUL_MISSION_3",
      "header_suffix": " probe-022.ogg",
      "audio": "probe-022.ogg",
      "header_eol": "\n",
      "body_suffix": "\n\n",
      "body": "REPLICATION STATUS\nEIGHT REPLICATIONS\nNEXT REPLICATION 85 PERCENT COMPLETE\nESTIMATED REPLICATIONS SINCE DEPARTURE FROM POINT OF ORIGIN\n583 REPLICATIONS.\nESTIMATED REPLICATIONS PROJECTED ONE YEAR FROM THIS DATE\n14,784 REPLICATIONS.\nESTIMATED REPLICATIONS PROJECTED FIVE YEARS FROM THIS DATE\n45,786,412 REPLICATIONS.",
      "unit_kind": "whole",
      "payload_start": 0,
      "source": "REPLICATION STATUS\nEIGHT REPLICATIONS\nNEXT REPLICATION 85 PERCENT COMPLETE\nESTIMATED REPLICATIONS SINCE DEPARTURE FROM POINT OF ORIGIN\n583 REPLICATIONS.\nESTIMATED REPLICATIONS PROJECTED ONE YEAR FROM THIS DATE\n14,784 REPLICATIONS.\nESTIMATED REPLICATIONS PROJECTED FIVE YEARS FROM THIS DATE\n45,786,412 REPLICATIONS.",
